PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: atlas.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pulse_api?retryWrites=true&w=majority

# ── PostgreSQL (Neon.tech) ────────────────────────────────────────────────────
# Get from: neon.tech → your project → Connection String
DATABASE_URL=postgresql://<user>:<password>@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── RabbitMQ (CloudAMQP) ──────────────────────────────────────────────────────
# Get from: cloudamqp.com → your instance → AMQP URL
RABBITMQ_URL=amqps://<user>:<password>@lionfish.rmq.cloudamqp.com/<vhost>
RABBITMQ_QUEUE=api_hits

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_strong_random_secret_here_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
CLIENT_URL=https://your-dashboard.vercel.app
